{
  "name": "ubair-website",
  "version": "1.8.1-dev",
  "description": "Uintah Basin Air Quality Website",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "test-api": "NODE_OPTIONS='-r dotenv/config' node scripts/test-api.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:snow": "NODE_OPTIONS='--experimental-vm-modules' jest snowDetection.test.js",
    "test:confidence": "NODE_OPTIONS='--experimental-vm-modules' jest confidenceThresholds.test.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.0.0",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "gifuct-js": "^2.1.2",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "1.5.3",
    "multer": "^2.5.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.6",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.5.28",
    "supertest": "^7.3.0"
  }
}
